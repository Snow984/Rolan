<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="PrimaryBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SecondaryBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryText" Color="#333333" />
    <SolidColorBrush x:Key="SecondaryText" Color="#666666" />
    <SolidColorBrush x:Key="Accent" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHover" Color="#106EBE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TabActive" Color="#0078D4" />
    <SolidColorBrush x:Key="TabInactive" Color="#E0E0E0" />
    
</ResourceDictionary>
