
&lt;Window x:Class="Rolan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="400" Width="350"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"&gt;
    
    &lt;Grid Margin="16"&gt;
        &lt;Grid.RowDefinitions&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
            &lt;RowDefinition Height="*" /&gt;
            &lt;RowDefinition Height="Auto" /&gt;
        &lt;/Grid.RowDefinitions&gt;
        
        &lt;TextBlock Grid.Row="0" Text="快捷键设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/&gt;
        &lt;StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"&gt;
            &lt;TextBlock Text="全局热键:" Margin="0,0,8,0" VerticalAlignment="Center"/&gt;
            &lt;TextBox x:Name="HotkeyBox" Width="150" Text="{Binding HotKey}" /&gt;
            &lt;TextBlock Text="示例: Alt+`" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666"/&gt;
        &lt;/StackPanel&gt;
        
        &lt;TextBlock Grid.Row="2" Text="界面设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/&gt;
        &lt;StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8"&gt;
            &lt;TextBlock Text="主题:" Margin="0,0,8,0" VerticalAlignment="Center"/&gt;
            &lt;ComboBox x:Name="ThemeCombo" Width="150" 
                      SelectedItem="{Binding Theme, Converter={local:EnumToStringConverter}}"&gt;
                &lt;ComboBoxItem&gt;Light&lt;/ComboBoxItem&gt;
                &lt;ComboBoxItem&gt;Dark&lt;/ComboBoxItem&gt;
                &lt;ComboBoxItem&gt;System&lt;/ComboBoxItem&gt;
            &lt;/ComboBox&gt;
        &lt;/StackPanel&gt;
        &lt;StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8"&gt;
            &lt;TextBlock Text="布局:" Margin="0,0,8,0" VerticalAlignment="Center"/&gt;
            &lt;ComboBox x:Name="LayoutCombo" Width="150"
                      SelectedItem="{Binding Layout, Converter={local:EnumToStringConverter}}"&gt;
                &lt;ComboBoxItem&gt;Vertical&lt;/ComboBoxItem&gt;
                &lt;ComboBoxItem&gt;Horizontal&lt;/ComboBoxItem&gt;
                &lt;ComboBoxItem&gt;SinglePage&lt;/ComboBoxItem&gt;
            &lt;/ComboBox&gt;
        &lt;/StackPanel&gt;
        &lt;StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,16"&gt;
            &lt;TextBlock Text="透明度:" Margin="0,0,8,0" VerticalAlignment="Center"/&gt;
            &lt;Slider x:Name="TransparencySlider" Width="150" Minimum="50" Maximum="100" 
                     Value="{Binding Transparency}" /&gt;
            &lt;TextBlock Text="{Binding Transparency}%" Margin="8,0,0,0" VerticalAlignment="Center"/&gt;
        &lt;/StackPanel&gt;
        
        &lt;TextBlock Grid.Row="6" Text="行为设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/&gt;
        &lt;StackPanel Grid.Row="7" Margin="0,0,0,16"&gt;
            &lt;CheckBox x:Name="AutoHideCheck" Content="启用边缘自动隐藏" 
                      IsChecked="{Binding AutoHide}" Margin="0,0,0,4"/&gt;
            &lt;CheckBox x:Name="HideOnLaunchCheck" Content="启动程序后隐藏窗口" 
                      IsChecked="{Binding HideOnLaunch}" Margin="0,0,0,4"/&gt;
            &lt;CheckBox x:Name="StayOnTopCheck" Content="窗口置顶" 
                      IsChecked="{Binding StayOnTop}" Margin="0,0,0,4"/&gt;
            &lt;CheckBox x:Name="AutoStartCheck" Content="开机自启" 
                      IsChecked="{Binding AutoStart}" Checked="AutoStartCheck_Checked" 
                      Unchecked="AutoStartCheck_Unchecked"/&gt;
        &lt;/StackPanel&gt;
        
        &lt;StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"&gt;
            &lt;Button x:Name="OKBtn" Width="80" Margin="0,0,8,0" Click="OKBtn_Click"&gt;确定&lt;/Button&gt;
            &lt;Button x:Name="CancelBtn" Width="80" Click="CancelBtn_Click"&gt;取消&lt;/Button&gt;
        &lt;/StackPanel&gt;
    &lt;/Grid&gt;
&lt;/Window&gt;
