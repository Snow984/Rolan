<Window x:Class="Rolan.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Rolan.Converters"
        Title="设置" Height="400" Width="350"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="快捷键设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="全局热键:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBox x:Name="HotkeyBox" Width="150" Text="{Binding HotKey}" />
            <TextBlock Text="示例: Alt+`" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
        </StackPanel>
        
        <TextBlock Grid.Row="2" Text="界面设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="主题:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="ThemeCombo" Width="150" 
                      SelectedItem="{Binding Theme, Converter={local:EnumToStringConverter}}">
                <ComboBoxItem>Light</ComboBoxItem>
                <ComboBoxItem>Dark</ComboBoxItem>
                <ComboBoxItem>System</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="布局:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="LayoutCombo" Width="150"
                      SelectedItem="{Binding Layout, Converter={local:EnumToStringConverter}}">
                <ComboBoxItem>Vertical</ComboBoxItem>
                <ComboBoxItem>Horizontal</ComboBoxItem>
                <ComboBoxItem>SinglePage</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="透明度:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <Slider x:Name="TransparencySlider" Width="150" Minimum="50" Maximum="100" 
                     Value="{Binding Transparency}" />
            <TextBlock Text="{Binding Transparency}%" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        
        <TextBlock Grid.Row="6" Text="行为设置" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="7" Margin="0,0,0,16">
            <CheckBox x:Name="AutoHideCheck" Content="启用边缘自动隐藏" 
                      IsChecked="{Binding AutoHide}" Margin="0,0,0,4"/>
            <CheckBox x:Name="HideOnLaunchCheck" Content="启动程序后隐藏窗口" 
                      IsChecked="{Binding HideOnLaunch}" Margin="0,0,0,4"/>
            <CheckBox x:Name="StayOnTopCheck" Content="窗口置顶" 
                      IsChecked="{Binding StayOnTop}" Margin="0,0,0,4"/>
            <CheckBox x:Name="AutoStartCheck" Content="开机自启" 
                      IsChecked="{Binding AutoStart}" Checked="AutoStartCheck_Checked" 
                      Unchecked="AutoStartCheck_Unchecked"/>
        </StackPanel>
        
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OKBtn" Width="80" Margin="0,0,8,0" Click="OKBtn_Click">确定</Button>
            <Button x:Name="CancelBtn" Width="80" Click="CancelBtn_Click">取消</Button>
        </StackPanel>
    </Grid>
</Window>
